# Copy to .env and fill in ONE of the options below, then restart `npx expo start`.

# Option A (development): call OpenAI directly from the app.
# WARNING: EXPO_PUBLIC_* values are bundled into the app — never ship a real key in a store build.
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional: override the vision model (default: gpt-4o-mini). gpt-4o is more accurate but costs more.
EXPO_PUBLIC_OPENAI_MODEL=

# Option B (production): your own backend that holds the OpenAI key.
# It receives POST { "image": "<base64 jpeg>" } and must return PlantIdentification JSON
# (see services/types.ts). When set, this takes priority over the key above.
EXPO_PUBLIC_PLANTID_API_URL=
